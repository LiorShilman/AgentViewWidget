<UserControl x:Class="AgentLiveWidget.EnergyCore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="52" Height="52">
    <Grid Width="52" Height="52">

        <!-- Soft outer glow -->
        <Ellipse x:Name="Halo" Width="52" Height="52" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="HaloStop0" Color="#8022D3EE" Offset="0"/>
                    <GradientStop x:Name="HaloStop1" Color="#0022D3EE" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Rotating segmented ring -->
        <Ellipse x:Name="Ring" Width="38" Height="38"
                 StrokeThickness="2"
                 StrokeDashArray="1.1,2.6" StrokeDashCap="Round"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Stroke>
                <SolidColorBrush x:Name="RingBrush" Color="#22D3EE"/>
            </Ellipse.Stroke>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingRotate"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Orbiting particles (positioned as an equilateral triangle, radius 19) -->
        <Canvas x:Name="ParticleGroup" Width="52" Height="52" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="ParticleRotate"/>
            </Canvas.RenderTransform>
            <Ellipse x:Name="Particle1" Width="4" Height="4" Canvas.Left="24" Canvas.Top="5">
                <Ellipse.Fill><SolidColorBrush x:Name="Particle1Brush" Color="#22D3EE"/></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Particle2" Width="4" Height="4" Canvas.Left="40" Canvas.Top="34">
                <Ellipse.Fill><SolidColorBrush x:Name="Particle2Brush" Color="#22D3EE"/></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Particle3" Width="4" Height="4" Canvas.Left="8" Canvas.Top="34">
                <Ellipse.Fill><SolidColorBrush x:Name="Particle3Brush" Color="#22D3EE"/></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Inner glowing core -->
        <Ellipse x:Name="Core" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop x:Name="CoreStop1" Color="#22D3EE" Offset="0.55"/>
                    <GradientStop x:Name="CoreStop2" Color="#0022D3EE" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale"/>
            </Ellipse.RenderTransform>
        </Ellipse>

    </Grid>
</UserControl>
