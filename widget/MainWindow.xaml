<Window x:Class="AgentLiveWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentLiveWidget"
        Title="Agent Live Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DotGlowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.2" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="DotGlowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.2" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="DotGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0" Duration="0:0:1.4"/>
        </Storyboard>

        <Storyboard x:Key="CompactPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CompactDotGlowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.2" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="CompactDotGlowScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.2" Duration="0:0:1.4"/>
            <DoubleAnimation Storyboard.TargetName="CompactDotGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0" Duration="0:0:1.4"/>
        </Storyboard>

        <Storyboard x:Key="MemPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MemFill"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.4" Duration="0:0:0.55"/>
        </Storyboard>

    </Window.Resources>

    <Grid Margin="16">

        <!-- ================= EXPANDED CARD ================= -->
        <Border x:Name="ExpandedRoot"
                Width="420"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{StaticResource PanelBorderBrush}"
                Background="{StaticResource PanelBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
            <StackPanel Margin="16,13,16,14">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="DotGlow" Fill="#F87171" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DotGlowScale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="DotCore" Fill="#F87171" Width="9" Height="9"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProjectNameText"
                                       Text="Agent Live"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="GitBadge"
                                    Visibility="Collapsed"
                                    CornerRadius="5"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="5,1,5,1"
                                    Margin="6,1,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GitBadgeDot"
                                             Width="6" Height="6"
                                             Margin="0,0,4,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="GitBadgeText"
                                               Text="main"
                                               FontSize="9.5"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Offline"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Grid x:Name="MemorySaveIndicator"
                          Grid.Column="2"
                          Margin="0,0,6,0"
                          Opacity="0"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          ToolTip="Saved to memory">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MemorySaveScale"/>
                        </Grid.RenderTransform>
                        <TextBlock Text="&#x2726;" FontSize="14" Foreground="{StaticResource AccentVioletBrush}"/>
                    </Grid>

                    <TextBlock x:Name="SessionTimeText"
                               Grid.Column="3"
                               Text="--:--"
                               FontSize="11"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE70E;"
                                ToolTip="Collapse"
                                Click="CollapseButton_Click"/>
                        <Button x:Name="HideButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE8BB;"
                                ToolTip="Hide to tray"
                                Click="HideButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Project tabs (shown only when tracking more than one project) -->
                <WrapPanel x:Name="TabsPanel"
                           Orientation="Horizontal"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>

                <!-- Current activity -->
                <Border Margin="0,12,0,0"
                        CornerRadius="10"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="10,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <local:EnergyCore x:Name="ActivityCore" Width="52" Height="52" Margin="-6,-6,-6,-6"/>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ToolNameText"
                                       Text="Idle"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToolFileText"
                                       Text="No active tool"
                                       FontSize="10.5"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Last prompt -->
                <Grid Margin="2,10,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x276F;"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentVioletBrush}"
                               Margin="0,1,7,0"
                               VerticalAlignment="Top"/>
                    <TextBlock x:Name="PromptText"
                               Grid.Column="1"
                               Text="No prompt yet"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="60"
                               VerticalAlignment="Top"/>
                </Grid>

                <!-- Last response -->
                <Grid Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x276E;"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}"
                               Margin="0,1,7,0"
                               VerticalAlignment="Top"/>
                    <TextBlock x:Name="ResponseText"
                               Grid.Column="1"
                               Text="No response yet"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="60"
                               VerticalAlignment="Top"/>
                </Grid>

                <!-- Files changed this session (hidden until at least one file is touched) -->
                <StackPanel x:Name="FilesChangedSection" Margin="2,13,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="FilesChangedLabel"
                               Text="FILES CHANGED"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <WrapPanel x:Name="FilesChangedPanel"
                               Orientation="Horizontal"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Context pressure -->
                <Grid Margin="2,11,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="CONTEXT PRESSURE"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="MemLabel"
                                   Text="NORMAL"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="#34D399"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Grid.Row="1"
                            x:Name="MemTrack"
                            Height="4"
                            Margin="0,5,0,0"
                            CornerRadius="2"
                            Background="{StaticResource TrackBrush}">
                        <Border x:Name="MemFill"
                                Height="4"
                                Width="70"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Background="{StaticResource MemNormalBrush}">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="MemShimmer"
                                           Width="26"
                                           Fill="#66FFFFFF"
                                           HorizontalAlignment="Left"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MemShimmerTranslate" X="-26"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- Recent activity -->
                <TextBlock Text="RECENT ACTIVITY"
                           FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="2,13,0,5"/>

                <Grid>
                    <TextBlock x:Name="EmptyLogText"
                               Text="Waiting for events…"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="2,2,0,2"/>
                    <ScrollViewer MaxHeight="220"
                                  Style="{StaticResource SlimScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventsList" Margin="2,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="11"
                                                   Foreground="{Binding IconBrush}"
                                                   Opacity="0.9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Opacity="0.85"
                                                   Margin="6,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeAgo}"
                                                   FontSize="10"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </StackPanel>

            <!-- Overlay for one-shot effects (e.g. the core-to-log flow particle) -->
            <Canvas x:Name="EffectsOverlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ================= COMPACT PILL ================= -->
        <Border x:Name="CompactRoot"
                Visibility="Collapsed"
                Height="42"
                CornerRadius="21"
                BorderThickness="1"
                BorderBrush="{StaticResource PanelBorderBrush}"
                Background="{StaticResource PanelBackgroundBrush}"
                Padding="15,0,7,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse x:Name="CompactDotGlow" Fill="#F87171" Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="CompactDotGlowScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="CompactDotCore" Fill="#F87171" Width="9" Height="9"/>
                </Grid>
                <TextBlock x:Name="CompactStatusText"
                           Text="Offline"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="9,0,6,0"
                           VerticalAlignment="Center"/>
                <Button x:Name="ExpandButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE70D;"
                        ToolTip="Expand"
                        Click="ExpandButton_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
